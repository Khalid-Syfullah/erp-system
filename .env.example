# Local development environment.
#   cp .env.example .env    and replace every "change-me" value.
# .env is git-ignored. Never commit real credentials. Production secrets come from the
# platform's secret manager, never from a file in the repository.

# --- PostgreSQL (docker compose) ---------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
ERP_DB_PORT=5432

# Login roles created by infra/db/bootstrap/00-roles.sql (passwords set at container init)
ERP_DB_MIGRATOR_USER=erp_migrator
ERP_DB_MIGRATOR_PASSWORD=change-me-migrator
ERP_DB_APP_USER=erp_app
ERP_DB_APP_PASSWORD=change-me-app

# --- Backend ---------------------------------------------------------------------------
# Used by `./gradlew bootRun` (profile "local") and by the compose "app" profile.
ERP_DB_URL=jdbc:postgresql://localhost:5432/erp
# Base64-encoded random key of at least 32 bytes, e.g. `openssl rand -base64 48`.
# Optional for the local profile (an ephemeral key is generated); required for prod.
ERP_API_CURSOR_SIGNING_KEY=
