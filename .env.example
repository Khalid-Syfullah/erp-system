# Local development environment.
#   cp .env.example .env    and replace every "change-me" value.
# .env is git-ignored. Never commit real credentials. Production secrets come from the
# platform's secret manager, never from a file in the repository.

# --- PostgreSQL (docker compose) ---------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
ERP_DB_PORT=5432

# Login roles created by infra/db/bootstrap/00-roles.sql (passwords set at container init)
ERP_DB_MIGRATOR_USER=erp_migrator
ERP_DB_MIGRATOR_PASSWORD=change-me-migrator
ERP_DB_APP_USER=erp_app
ERP_DB_APP_PASSWORD=change-me-app
# Read-only reporting role (Phase 10): reports read the v_rpt_* views through it.
ERP_DB_REPORTING_USER=erp_reporting
ERP_DB_REPORTING_PASSWORD=change-me-reporting

# --- Backend ---------------------------------------------------------------------------
# Used by `./gradlew bootRun` (profile "local") and by the compose "app" profile.
ERP_DB_URL=jdbc:postgresql://localhost:5432/erp
# Base64-encoded random key of at least 32 bytes, e.g. `openssl rand -base64 48`.
# Optional for the local profile (an ephemeral key is generated); required for prod.
ERP_API_CURSOR_SIGNING_KEY=

# --- Security (SECURITY.md §3, §7.2, §10) ------------------------------------------------
# Exact origins of the web application, comma-separated. Required for prod.
# ERP_SECURITY_ALLOWED_ORIGINS=http://localhost:5173
# Field-encryption keys (AES-256-GCM, MFA secrets): <version>:<base64 32 bytes>[,...]; the highest
# version encrypts, older versions still decrypt. e.g. `echo "1:$(openssl rand -base64 32)"`.
# Optional for the local profile (an ephemeral key is generated, so MFA enrollments do not survive
# a restart); required for prod.
ERP_FIELD_ENCRYPTION_KEYS=

# Optional settings below are commented out: an empty value would override the profile defaults.

# --- Authentication emails (invitations, password reset, lockout) --------------------------
# Base URL of the web application; links are <base>/invite#token=... and <base>/reset-password#token=...
# ERP_AUTH_PUBLIC_BASE_URL=http://localhost:5173
# ERP_MAIL_FROM=no-reply@erp.invalid
# SMTP. The local profile defaults to Mailpit (localhost:1025, UI on http://localhost:8025).
# ERP_MAIL_HOST=
# ERP_MAIL_PORT=
# ERP_MAIL_USERNAME=
# ERP_MAIL_PASSWORD=
# ERP_MAIL_STARTTLS=

# --- Object storage (ARCHITECTURE.md §8.6) -------------------------------------------------
# Required for prod: the S3 bucket. Credentials come from the AWS default chain unless set.
# ERP_FILES_BUCKET=
# ERP_FILES_REGION=
# ERP_FILES_ENDPOINT=
# ERP_FILES_ACCESS_KEY=
# ERP_FILES_SECRET_KEY=

# --- Background jobs -----------------------------------------------------------------------
# Recurring maintenance (audit partitions, security-record purges). true on exactly the worker
# instance(s); the local profile enables it by default.
# ERP_JOBS_ENABLED=

# --- First system administrator (one-shot, profile "bootstrap-admin") ----------------------
#   cd backend && SPRING_PROFILES_ACTIVE=local,bootstrap-admin ./gradlew bootRun
# Does nothing when an active system administrator exists. MFA enrollment is enforced at first login.
# ERP_BOOTSTRAP_ADMIN_EMAIL=
# ERP_BOOTSTRAP_ADMIN_PASSWORD=
# ERP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
